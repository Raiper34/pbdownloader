{
  "name": "pbdownloader",
  "version": "0.0.1",
  "description": "Full-stack web application for automating file downloads via configurable Puppeteer workflows",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --names 'BE,FE' --prefix-colors 'blue,green' \"npm run start:be\" \"npm run start:fe\"",
    "start:be": "npm run start:dev -w backend",
    "start:fe": "npm run start -w frontend",
    "build:be": "npm run build -w backend",
    "build:fe": "npm run build -w frontend",
    "build": "npm run build:be && npm run build:fe",
    "start": "npm run start:prod -w backend",
    "clean": "rimraf node_modules backend/node_modules frontend/node_modules",
    "changelog": "auto-changelog -p",
    "release": "release-it",
    "commit": "cz"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.1",
    "auto-changelog": "^2.5.0",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "release-it": "^18.1.2",
    "release-it-docker-plugin": "^2.0.0",
    "rimraf": "^6.0.1"
  }
}
