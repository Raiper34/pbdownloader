{
  "$schema": "https://unpkg.com/release-it@17/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): v${version}",
    "changelog": "npm run changelog -- --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "in": "package.json",
      "out": ["backend/package.json", "frontend/package.json"]
    },
    "release-it-docker-plugin": {
      "latestTag": true,
      "imageName": "raiper34/pbdownloader",
      "buildx": true,
      "builder": "container",
      "platform": "linux/arm64,linux/amd64",
      "output": "registry"
    }
  },
  "hooks": {
    "after:bump": ["npm run changelog", "npm run build"],
    "after:release": []
  }
}
