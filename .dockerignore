# Ignore large/unnecessary directories from Docker build context
.git
.idea
.vscode

# Dependencies (each subproject installs its own)
node_modules
backend/node_modules
frontend/node_modules

# Build artifacts
dist
backend/dist
frontend/dist

# Runtime data
backend/data
backend/downloads
*.sqlite

# Env files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Logs
*.log
npm-debug.log*

# Test & coverage
coverage
backend/coverage
frontend/coverage

# Angular cache
frontend/.angular

# OS
.DS_Store
Thumbs.db
